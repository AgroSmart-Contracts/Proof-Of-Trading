%% System overview: the pilot pool on Stellar (design for Tranche 1; the testnet record is the v0.2 prototype)
flowchart LR
  subgraph TM["TruMarket (off-chain, private)"]
    DOC["Export declaration, invoice,<br/>buyer tax ID, documents"] --> KEY["Attestation key + document hash"]
    KYB["KYB: legal entities,<br/>min. USD 50,000"]
  end

  subgraph ST["Stellar"]
    PC["Pool contract (Soroban)"]
    RS[("Persistent storage:<br/>attestations, status history, pool state")]
    SH["Pool share<br/>AUTH_REQUIRED · REVOCABLE · CLAWBACK<br/>+ its SAC"]
    USDC["Circle USDC SAC"]
    COL["Collection account<br/>2-of-3"]
  end

  INV["Investor wallet<br/>Wallets Kit · Freighter · Privy"]
  BR["Bridge<br/>buyer USD to USDC"]
  KOY["Koywe<br/>USDC to PEN / CLP"]
  VER["Indexer / explorer"]

  KEY -- "attest" --> PC
  PC --- RS
  KYB -- "authorize holder" --> SH
  PC -- "SAC admin: mint, burn" --> SH
  INV -- "subscribe (USDC)" --> PC
  PC -- "release" --> KOY
  BR --> COL
  COL -- "settle" --> PC
  PC -- "distribute, redeem" --> INV
  USDC -.- PC
  RS -- "events" --> VER
